// Schema shape is decided in docs/01-architecture-decisions.md (D4, D4b, D7)
// and docs/07-food-log.md. Keep it free of Postgres-specific types (D3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A session defined once and reused, never retyped per day.
model WorkoutType {
  id     String  @id @default(cuid())
  name   String  @unique
  isRest Boolean @default(false)
  days   Day[]
}

// Singleton: the app's standing configuration (D4). The workout for any date
// is computed from pattern + anchorDate (rule R1b), never pre-generated.
model Settings {
  id            String @id @default("singleton")
  // "weekly" | "cycle"
  scheduleMode  String
  // cycle: [typeId, ...] indexed from anchorDate
  // weekly: [typeId x7], index 0 = Sunday
  pattern       Json
  // YYYY-MM-DD, day 0 of the cycle (rule R7)
  anchorDate    String
  // Defaults when no Block covering a date sets targets (D7, rule R6b).
  calTarget     Int?
  proteinTarget Int?
}

// Optional label over a date range. Not a container: it has no relation to
// Day and covers one only by date (D4). Overlaps and retroactive blocks are fine.
model Block {
  id            String  @id @default(cuid())
  name          String
  // Calendar dates as YYYY-MM-DD strings (rule R7). Never timestamps.
  startDate     String
  // null = ongoing
  endDate       String?
  startWeight   Float?
  goalWeight    Float?
  // Overrides Settings targets for dates in range (D7, rule R6b).
  calTarget     Int?
  proteinTarget Int?
}

// One row per calendar date, created the first time something is logged on
// it (rule R1b). Calories and protein are not columns: they sum from Entry
// rows (rule R6c).
model Day {
  id            String       @id @default(cuid())
  date          String       @unique // YYYY-MM-DD
  // Override for this one day; null follows Settings.pattern.
  workoutType   WorkoutType? @relation(fields: [workoutTypeId], references: [id])
  workoutTypeId String?
  trained       Boolean      @default(false)
  weight        Float?
  notes         String?
  entries       Entry[]
}

model FoodItem {
  id        String    @id @default(cuid())
  name      String
  calories  Int
  protein   Int
  timesUsed Int       @default(0)
  lastUsed  DateTime?
  archived  Boolean   @default(false)
  entries   Entry[]
}

// Entries copy the numbers rather than referencing them, so correcting a
// saved item never rewrites history. itemId exists for usage counts only.
model Entry {
  id       String    @id @default(cuid())
  day      Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId    String
  item     FoodItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId   String?
  name     String?
  calories Int
  protein  Int
  loggedAt DateTime  @default(now())

  @@index([dayId])
}
